<%- | Array[String] $urls, Enum['https', 'http'] $protocol, Integer[1] $http_timeout_seconds, Stdlib::Absolutepath $tls_cert_file = '/etc/telegraf/puppet_cert.pem', Stdlib::Absolutepath $tls_key_file = '/etc/telegraf/puppet_key.pem', Stdlib::Absolutepath $tls_ca_file = '/etc/telegraf/puppet_ca.pem' | -%>
<% if $protocol == 'https' { -%>
tls_cert = "<%= $tls_cert_file %>"
tls_key = "<%= $tls_key_file %>"
tls_ca = "<%= $tls_ca_file %>"
<% } -%>
data_format = "json_v2"
headers = {"Content-type" = "application/json"}
timeout = "<%= $http_timeout_seconds %>s"
   method = 'GET'
   urls = <%= $urls %>
[[json_v2]]
   measurement_name = 'orchestrator'
   [[json_v2.object]]
      path = '@this'
      tags = ["request_mbean"]
      excluded_keys = ['value_RateUnit', 'value_DurationUnit', 'request_type', 'status', 'timestamp', 'error', 'error_type']
      disable_prepend_keys = true
